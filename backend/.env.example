# ============================================================
# Automate Trading — Backend Environment Variables
# ============================================================

# PostgreSQL connection string (AWS RDS recommended for production)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/automate_trading

# CORS — use * for mobile apps or specify your domain
CORS_ORIGINS=*

# Fernet encryption key for Dhan access tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Secret used to sign OTP hashes and internal service calls
INTERNAL_SECRET=change-me-to-a-random-secret

# Secret for the one-time admin bootstrap endpoint (/api/auth/admin-bootstrap)
ADMIN_SECRET=change-me-to-a-random-secret

# Session length
AUTH_SESSION_HOURS=168
OTP_EXPIRY_MINUTES=10

# ---- Email (for password-reset OTP) --------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com

# ---- Firebase Cloud Messaging (FCM) --------------------------------
# Option A: path to the Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=/etc/automate-trading/firebase-service-account.json
# Option B: the JSON content as a single-line string (takes precedence over path)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ---- IPv6 pool (auto-assignment on registration) -------------------
# Prefix carved from the AWS ENI delegated block (from poc.md).
# Each new user gets the next sequential address: prefix1, prefix2, …
# Leave empty to disable auto-assignment (admin sets IPv6 manually).
IPV6_POOL_PREFIX=2406:da1a:c1e:f000:bb82::
IPV6_POOL_START=1
# Network interface name on the EC2 instance (ip link show to find it).
IPV6_INTERFACE=ens5
# Auto-add newly assigned IPv6 addresses to the OS interface + persistent config.
# Requires CAP_NET_ADMIN or: ec2-user ALL=(ALL) NOPASSWD: /usr/sbin/ip addr add *
IPV6_AUTO_PROVISION=true
