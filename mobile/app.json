{
  "expo": {
    "name": "TradingFloor",
    "slug": "automate-trading",
    "version": "1.2.5",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#141D2C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.automatetrading.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpeg",
        "backgroundColor": "#141D2C"
      },
      "package": "com.automatetrading.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "automatetrading",
    "extra": {
      "apiBaseUrl": "http://13.126.206.167",
      "router": {},
      "eas": {
        "projectId": "36c4d8e8-7158-45df-9de4-44a629d105ad"
      }
    }
  }
}
