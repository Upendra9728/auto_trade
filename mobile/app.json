{
  "expo": {
    "name": "Automate Trading",
    "slug": "automate-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.automatetrading.app"
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#1E40AF" },
      "package": "com.automatetrading.app",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "scheme": "automatetrading",
    "extra": {
      "apiBaseUrl": "http://YOUR_EC2_PUBLIC_IP"
    }
  }
}
